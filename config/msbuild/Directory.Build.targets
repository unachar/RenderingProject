<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RayTelemetryShaderInputs>$(RenderRoot)shader\hlsl\RayTelemetry.hlsli;$(RenderRoot)source\rendering\raytelemetrylayout.h;$(RenderRoot)source\rendering\stablesampling.h;$(RenderRoot)shader\hlsl\Stbn.hlsli</RayTelemetryShaderInputs>
  </PropertyGroup>




  <Import Project="$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets" Condition="'$(Platform)' == 'x64' and Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets')" />






  <PropertyGroup Condition="'$(Platform)' == 'x64' and '$(WindowsSDK_ExecutablePath_x64)' != ''">
    <FXCToolPath>$(WindowsSDK_ExecutablePath_x64.Split(';')[0])</FXCToolPath>
  </PropertyGroup>

  <Target Name="EnsureDirectXShaderCompilerNuGetPackage" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x64'">
    <PropertyGroup>
      <DxcMissingPackageMessage>DXC NuGet package is missing. Restore NuGet packages before building. Missing file: {0}</DxcMissingPackageMessage>
    </PropertyGroup>
    <Error Condition="!Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props')" Text="$([System.String]::Format('$(DxcMissingPackageMessage)', '$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props'))" />
    <Error Condition="!Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets')" Text="$([System.String]::Format('$(DxcMissingPackageMessage)', '$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets'))" />
  </Target>
  <Target Name="CompileDlssHelperShaders" BeforeTargets="ClCompile" DependsOnTargets="CompileDlssHelperShadersDlssPrepareCS;CompileDlssHelperShadersDlssCopyCS" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'" />

  <Target Name="CompileDlssHelperShadersDlssPrepareCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\DlssPrepareCS.hlsl;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\DlssPrepareCS.cso" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Prepare -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\DlssPrepareCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\DlssPrepareCS.hlsl&quot;" />
  </Target>
  <Target Name="CompileDlssHelperShadersDlssCopyCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\DlssPrepareCS.hlsl;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\DlssCopyCS.cso" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Copy -D DLSS_COPY=1 -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\DlssCopyCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\DlssPrepareCS.hlsl&quot;" />
  </Target>
  <Target Name="CopyDlssRuntime" AfterTargets="Build" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <Copy SourceFiles="$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlss.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(DlssSdkRoot)LICENSE.txt" DestinationFiles="$(OutDir)..\licenses\NVIDIA_DLSS_LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNrdLicense" AfterTargets="Build" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <Copy SourceFiles="$(NrdSdkRoot)LICENSE.txt" DestinationFiles="$(OutDir)..\licenses\NVIDIA_NRD_LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyOcioRuntime" AfterTargets="Build" Condition="'$(EnableOcio)' == 'true' and '$(Platform)' == 'x64'">
    <ItemGroup>
      <_OcioRuntime Include="$(OcioRoot)install\bin\OpenColorIO*.dll" />
    </ItemGroup>
    <Error Condition="'@(_OcioRuntime)' == ''" Text="OpenColorIO is enabled but its runtime DLL is missing from $(OcioRoot)install\bin." />
    <Copy SourceFiles="@(_OcioRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OcioRoot)LICENSE" DestinationFiles="$(OutDir)..\licenses\OpenColorIO_LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyTracyLicense" AfterTargets="Build" Condition="'$(EnableTracy)' == 'true' and '$(Platform)' == 'x64'">
    <Copy SourceFiles="$(RenderRoot)External\tracy\LICENSE" DestinationFiles="$(OutDir)..\licenses\Tracy_LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyFastGltfLicenses" AfterTargets="Build" Condition="'$(EnableFastGltf)' == 'true' and '$(Platform)' == 'x64'">
    <ItemGroup>
      <FastGltfDependencyLicenses Include="$(FastGltfRoot)dependency-licenses\*" />
    </ItemGroup>
    <Copy SourceFiles="$(FastGltfRoot)LICENSE.md" DestinationFiles="$(OutDir)..\licenses\fastgltf_LICENSE.md" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(FastGltfSdkRoot)bin\FastGltfAdapter.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(RenderRoot)External\Draco\LICENSE" DestinationFiles="$(OutDir)..\licenses\Draco_LICENSE.txt" SkipUnchangedFiles="true" Condition="Exists('$(RenderRoot)External\Draco\LICENSE')" />
    <Copy SourceFiles="@(FastGltfDependencyLicenses)" DestinationFolder="$(OutDir)..\licenses\fastgltf-LICENSES" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAclLicenses" AfterTargets="Build" Condition="'$(EnableAcl)' == 'true' and '$(Platform)' == 'x64'">
    <Copy SourceFiles="$(AclRoot)LICENSE" DestinationFiles="$(OutDir)..\licenses\ACL_LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(AclRoot)upstream\external\rtm\LICENSE" DestinationFiles="$(OutDir)..\licenses\RTM_LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyKtxRuntime" AfterTargets="Build" Condition="'$(EnableKtx)' == 'true' and '$(Platform)' == 'x64'">
    <Copy SourceFiles="$(KtxSdkRoot)bin\ktx.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(KtxRoot)LICENSE.md" DestinationFiles="$(OutDir)..\licenses\KTX_LICENSE.md" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_KtxLicense Include="$(KtxRoot)upstream\LICENSES\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(_KtxLicense)" DestinationFolder="$(OutDir)..\licenses\KTX-LICENSES" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(KtxRoot)upstream\external\basis_universal\LICENSE" DestinationFiles="$(OutDir)..\licenses\BasisUniversal_LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(KtxRoot)upstream\external\basis_universal\NOTICE" DestinationFiles="$(OutDir)..\licenses\BasisUniversal_NOTICE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CompileRaytracingShader" BeforeTargets="ClCompile" DependsOnTargets="CompileRaytracingShaderRaytracingCS" Condition="'$(Platform)' == 'x64'" />

  <Target Name="CompileRaytracingShaderRaytracingCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\RaytracingCS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -D USE_NRD=0 -HV 2021 -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\RaytracingCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </Target>
  <Target Name="CompileNrdRaytracingShaders" BeforeTargets="ClCompile" DependsOnTargets="CompileNrdRaytracingShadersRaytracingNrdCS;CompileNrdRaytracingShadersNrdComposeShadowCS;CompileNrdRaytracingShadersNrdComposeAmbientCS" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'" />

  <Target Name="CompileNrdRaytracingShadersRaytracingNrdCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)External\NRD\sdk\Shaders\NRD.hlsli;$(RenderRoot)External\NRD\sdk\Shaders\NRDConfig.hlsli;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\RaytracingNrdCS.cso" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\RaytracingNrdCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </Target>
  <Target Name="CompileNrdRaytracingShadersNrdComposeShadowCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)External\NRD\sdk\Shaders\NRD.hlsli;$(RenderRoot)External\NRD\sdk\Shaders\NRDConfig.hlsli;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\NrdComposeShadowCS.cso" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E ComposeShadow -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\NrdComposeShadowCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </Target>
  <Target Name="CompileNrdRaytracingShadersNrdComposeAmbientCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)External\NRD\sdk\Shaders\NRD.hlsli;$(RenderRoot)External\NRD\sdk\Shaders\NRDConfig.hlsli;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\NrdComposeAmbientCS.cso" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E ComposeAmbient -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\NrdComposeAmbientCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </Target>
  <Target Name="CompileColorManagementShader" BeforeTargets="ClCompile" DependsOnTargets="CompileColorManagementShaderColorManagementCS" Condition="'$(EnableOcio)' == 'true' and '$(Platform)' == 'x64'" /><Target Name="CompileColorManagementShaderColorManagementCS" Inputs="$(RenderRoot)shader\hlsl\ColorManagement.hlsl;$(RenderRoot)shader\hlsl\ColorManagementCS.hlsl;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\ColorManagementCS.cso" Condition="'$(EnableOcio)' == 'true' and '$(Platform)' == 'x64'"><MakeDir Directories="$(RenderRoot)shader\hlsl\build" /><Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\ColorManagementCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\ColorManagementCS.hlsl&quot;" /></Target><Target Name="CompilePhase5Shaders" BeforeTargets="ClCompile" DependsOnTargets="CompilePhase5ShadersMeshletMS;CompilePhase5ShadersClusterCullingCS;CompilePhase5ShadersMeshletCullingCS;CompilePhase5ShadersBuildMeshDispatchCS;CompilePhase5ShadersMeshletResetCS;CompilePhase5ShadersMeshletOpaquePS;CompilePhase5ShadersMeshletFallbackVS;CompilePhase5ShadersMeshletVelocityMS;CompilePhase5ShadersMeshletVelocityPS;CompilePhase5ShadersMeshletVelocityVS" Condition="'$(Platform)' == 'x64'" />

  <Target Name="CompilePhase5ShadersMeshletMS" Inputs="$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\GpuSceneCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletMS.hlsl;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\MeshletMS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ms_6_5 -E main -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\MeshletMS.cso&quot; &quot;$(RenderRoot)shader\hlsl\MeshletMS.hlsl&quot;" />
  </Target>
  <Target Name="CompilePhase5ShadersClusterCullingCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\ClusterCullingCS.hlsl;$(RenderRoot)shader\hlsl\GpuSceneCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCullingCommon.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\ClusterCullingCS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
