  </Target>
  <Target Name="CompilePhase5ShadersMeshletResetCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\BuildMeshDispatchCS.hlsl;$(RenderRoot)shader\hlsl\GpuSceneCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCullingCommon.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\MeshletResetCS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Reset -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\MeshletResetCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\BuildMeshDispatchCS.hlsl&quot;" />
  </Target>
  <Target Name="CompilePhase5ShadersMeshletOpaquePS" Inputs="$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\GeometricSpecularAA.hlsli;$(RenderRoot)shader\hlsl\DeferredPS.hlsl;$(RenderRoot)shader\hlsl\GPUDrivenOpaque.hlsli;$(RenderRoot)shader\hlsl\GPUDrivenOpaquePS.hlsl;$(RenderRoot)shader\hlsl\GpuSceneCommon.hlsli;$(RenderRoot)shader\hlsl\MaterialSurface.hlsli;$(RenderRoot)shader\hlsl\ToonLighting.hlsli;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\MeshletOpaquePS.cso" Condition="'$(Platform)' == 'x64'">
