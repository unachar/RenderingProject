    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E Traverse -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\VirtualGeometryTraversalCS.cso&quot; &quot;$(RenderRoot)shader\hlsl\VirtualGeometryTraversalCS.hlsl&quot;" />
