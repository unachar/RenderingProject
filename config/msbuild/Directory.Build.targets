  <Target Name="CompileVirtualGeometryShaders" BeforeTargets="ClCompile" DependsOnTargets="CompileVirtualGeometryShadersVirtualGeometryResetCS;CompileVirtualGeometryShadersVirtualGeometryTraversalCS;CompileVirtualGeometryShadersVirtualGeometryArgumentsCS;CompileVirtualGeometryShadersVirtualGeometryMS;CompileVirtualGeometryShadersVirtualGeometryVelocityMS;CompileVirtualGeometryShadersVirtualGeometryOpaquePS;CompileVirtualGeometryShadersVirtualGeometryPartitionCS;CompileVirtualGeometryShadersVirtualGeometryRetestCS;CompileVirtualGeometryShadersVirtualGeometryTemporalArgumentsCS;CompileVirtualGeometryShadersVirtualGeometryBinsResetCS;CompileVirtualGeometryShadersVirtualGeometryBinsCountCS;CompileVirtualGeometryShadersVirtualGeometryBinsPrefixCS;CompileVirtualGeometryShadersVirtualGeometryBinsScatterCS;CompileVirtualGeometryShadersVirtualGeometryBinnedMS;CompileVirtualGeometryShadersVirtualGeometryBinnedVelocityMS" Condition="'$(Platform)' == 'x64'" />
  <Target Name="CompileVirtualGeometryShadersVirtualGeometryResetCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\VirtualGeometryTraversalCS.hlsl;$(RenderRoot)shader\hlsl\VirtualGeometryCommon.hlsli;$(RenderRoot)shader\hlsl\GpuSceneCommon.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\VirtualGeometryResetCS.cso" Condition="'$(Platform)' == 'x64'">
