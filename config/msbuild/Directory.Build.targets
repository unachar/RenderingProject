  </Target>
  <Target Name="CompilePhase5ShadersMeshletCullingCS" Inputs="$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\GpuSceneCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCullingCommon.hlsli;$(RenderRoot)shader\hlsl\MeshletCullingCS.hlsl;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props" Outputs="$(RenderRoot)shader\hlsl\build\MeshletCullingCS.cso" Condition="'$(Platform)' == 'x64'">
