  </Target>
  <Target Name="CompileMaterialShadowTransmissionPS"
          Inputs="$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\MaterialSurface.hlsli;$(RenderRoot)shader\hlsl\ToonLighting.hlsli;$(RenderRoot)shader\hlsl\MaterialTextureHeap.hlsli;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\PhysicalGlass.hlsli;$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(RenderRoot)shader\hlsl\ShadowTransmissionPS.hlsl;$(RenderRoot)shader\hlsl\ToneMapping.hlsli;$(RenderRoot)shader\hlsl\NoiseCacheLayout.hlsli;$(RenderRoot)shader\hlsl\StageLighting.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props;$(RenderRoot)shader\hlsl\MaterialGraphVM.hlsli"
