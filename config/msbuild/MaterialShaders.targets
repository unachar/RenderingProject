  </Target>
  <Target Name="CompileMaterialShadowMapPS"
          Inputs="$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\MaterialSurface.hlsli;$(RenderRoot)shader\hlsl\ToonLighting.hlsli;$(RenderRoot)shader\hlsl\MaterialTextureHeap.hlsli;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(RenderRoot)shader\hlsl\ShadowMapPS.hlsl;$(RenderRoot)shader\hlsl\ToneMapping.hlsli;$(RenderRoot)shader\hlsl\NoiseCacheLayout.hlsli;$(RenderRoot)shader\hlsl\StageLighting.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props;$(RenderRoot)shader\hlsl\MaterialGraphVM.hlsli"
          Outputs="$(RenderRoot)shader\hlsl\build\ShadowMapPS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\ShadowMapPS.cso&quot; &quot;$(RenderRoot)shader\hlsl\ShadowMapPS.hlsl&quot;" />
