  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <FileWrites Include="$(RenderRoot)shader\hlsl\build\ShadowMapPS.cso;$(RenderRoot)shader\hlsl\build\ShadowTransmissionPS.cso;$(RenderRoot)shader\hlsl\build\modellightingPS.cso;$(RenderRoot)shader\hlsl\build\DeferredLightingPS.cso;$(RenderRoot)shader\hlsl\build\DeferredPS.cso;$(RenderRoot)shader\hlsl\build\GeometryPS.cso;$(RenderRoot)shader\hlsl\build\modelshaderPS.cso;$(RenderRoot)shader\hlsl\build\modelshaderPS_MRT.cso;$(RenderRoot)shader\hlsl\build\GPUDrivenOpaquePS.cso" />
