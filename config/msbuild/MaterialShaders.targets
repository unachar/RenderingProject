  </Target>
  <Target Name="CompileMaterialmodelshaderPS_MRT"
          Inputs="$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\MaterialSurface.hlsli;$(RenderRoot)shader\hlsl\ToonLighting.hlsli;$(RenderRoot)shader\hlsl\MaterialTextureHeap.hlsli;$(RenderRoot)shader\hlsl\modelshaderPS_MRT.hlsl;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\NormalMapDecode.hlsli;$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(RenderRoot)shader\hlsl\ToneMapping.hlsli;$(RenderRoot)shader\hlsl\NoiseCacheLayout.hlsli;$(RenderRoot)shader\hlsl\StageLighting.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props;$(RenderRoot)shader\hlsl\MaterialGraphVM.hlsli"
          Outputs="$(RenderRoot)shader\hlsl\build\modelshaderPS_MRT.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\modelshaderPS_MRT.cso&quot; &quot;$(RenderRoot)shader\hlsl\modelshaderPS_MRT.hlsl&quot;" />
  </Target>
