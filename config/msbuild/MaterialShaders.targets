          Outputs="$(RenderRoot)shader\hlsl\build\GPUDrivenOpaquePS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\GPUDrivenOpaquePS.cso&quot; &quot;$(RenderRoot)shader\hlsl\GPUDrivenOpaquePS.hlsl&quot;" />
  </Target>
