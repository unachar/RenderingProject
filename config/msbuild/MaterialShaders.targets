<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The runtime uses DXC too. FXC stalls optimizing the dynamic material noise evaluator. -->
  <Target Name="CompileMaterialShaders" BeforeTargets="FxCompile"
          DependsOnTargets="CompileMaterialShadowMapPS;CompileMaterialShadowTransmissionPS;CompileMaterialmodellightingPS;CompileMaterialDeferredLightingPS;CompileMaterialDeferredPS;CompileMaterialGeometryPS;CompileMaterialmodelshaderPS;CompileMaterialmodelshaderPS_MRT;CompileMaterialGPUDrivenOpaquePS"
          Condition="'$(Platform)' == 'x64'" />
  <Target Name="CompileMaterialDeferredPS"
          Inputs="$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\GeometricSpecularAA.hlsli;$(RenderRoot)shader\hlsl\DeferredPS.hlsl;$(RenderRoot)shader\hlsl\GPUDrivenOpaque.hlsli;$(RenderRoot)shader\hlsl\GpuSceneCommon.hlsli;$(RenderRoot)shader\hlsl\MaterialSurface.hlsli;$(RenderRoot)shader\hlsl\ToonLighting.hlsli;$(RenderRoot)shader\hlsl\MaterialTextureHeap.hlsli;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\NormalMapDecode.hlsli;$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(RenderRoot)shader\hlsl\ToneMapping.hlsli;$(RenderRoot)shader\hlsl\LiveToonMaterial.hlsli;$(RenderRoot)shader\hlsl\NoiseCacheLayout.hlsli;$(RenderRoot)shader\hlsl\StageLighting.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props;$(RenderRoot)shader\hlsl\MaterialGraphVM.hlsli"
          Outputs="$(RenderRoot)shader\hlsl\build\DeferredPS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\DeferredPS.cso&quot; &quot;$(RenderRoot)shader\hlsl\DeferredPS.hlsl&quot;" />
  </Target>
  <Target Name="CompileMaterialGeometryPS"
          Inputs="$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\GeometryPS.hlsl;$(RenderRoot)shader\hlsl\MaterialSurface.hlsli;$(RenderRoot)shader\hlsl\ToonLighting.hlsli;$(RenderRoot)shader\hlsl\MaterialTextureHeap.hlsli;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\NormalMapDecode.hlsli;$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(RenderRoot)shader\hlsl\ToneMapping.hlsli;$(RenderRoot)shader\hlsl\NoiseCacheLayout.hlsli;$(RenderRoot)shader\hlsl\StageLighting.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props;$(RenderRoot)shader\hlsl\MaterialGraphVM.hlsli"
          Outputs="$(RenderRoot)shader\hlsl\build\GeometryPS.cso" Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(RenderRoot)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(RenderRoot)shader\hlsl\build\GeometryPS.cso&quot; &quot;$(RenderRoot)shader\hlsl\GeometryPS.hlsl&quot;" />
  </Target>
  <Target Name="CompileMaterialmodelshaderPS"
          Inputs="$(RenderRoot)shader\hlsl\AtmosphereLutCommon.hlsli;$(RenderRoot)shader\hlsl\CameraProjection.hlsli;$(RenderRoot)shader\hlsl\CelestialLighting.hlsli;$(RenderRoot)shader\hlsl\CloudMedium.hlsli;$(RenderRoot)shader\hlsl\common.hlsl;$(RenderRoot)shader\hlsl\GeometryGlass.hlsli;$(RenderRoot)shader\hlsl\GlassHitLighting.hlsli;$(RenderRoot)shader\hlsl\IesProfileSampling.hlsli;$(RenderRoot)shader\hlsl\MaterialOpticsPreview.hlsli;$(RenderRoot)shader\hlsl\MaterialSurface.hlsli;$(RenderRoot)shader\hlsl\MaterialTextureHeap.hlsli;$(RenderRoot)shader\hlsl\MegaLightsCommon.hlsli;$(RenderRoot)shader\hlsl\modelshaderPS.hlsl;$(RenderRoot)shader\hlsl\noise.hlsl;$(RenderRoot)shader\hlsl\NormalMapDecode.hlsli;$(RenderRoot)shader\hlsl\PhysicalGlass.hlsli;$(RenderRoot)shader\hlsl\ProceduralTexture.hlsli;$(RenderRoot)shader\hlsl\SceneRayShadow.hlsli;$(RenderRoot)shader\hlsl\SkyAtmosphere.hlsli;$(RenderRoot)shader\hlsl\SurfaceLighting.hlsli;$(RenderRoot)shader\hlsl\ToonLighting.hlsli;$(RenderRoot)shader\hlsl\ToneMapping.hlsli;$(RenderRoot)shader\hlsl\LiveToonMaterial.hlsli;$(RenderRoot)shader\hlsl\LiveToonStyle.hlsli;$(RenderRoot)shader\hlsl\NoiseCacheLayout.hlsli;$(RenderRoot)shader\hlsl\StageLighting.hlsli;$(MSBuildThisFileFullPath);$(RenderRoot)Directory.Build.props;$(RenderRoot)shader\hlsl\MaterialGraphVM.hlsli"
