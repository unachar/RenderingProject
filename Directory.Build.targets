<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">




  <Import Project="$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets"
          Condition="'$(Platform)' == 'x64' and Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets')" />






  <PropertyGroup Condition="'$(Platform)' == 'x64' and '$(WindowsSDK_ExecutablePath_x64)' != ''">
    <FXCToolPath>$(WindowsSDK_ExecutablePath_x64.Split(';')[0])</FXCToolPath>
  </PropertyGroup>

  <Target Name="EnsureDirectXShaderCompilerNuGetPackage"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Platform)' == 'x64'">
    <PropertyGroup>
      <DxcMissingPackageMessage>DXC NuGet package is missing. Restore NuGet packages before building. Missing file: {0}</DxcMissingPackageMessage>
    </PropertyGroup>
    <Error Condition="!Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props')"
           Text="$([System.String]::Format('$(DxcMissingPackageMessage)', '$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props'))" />
    <Error Condition="!Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets')"
           Text="$([System.String]::Format('$(DxcMissingPackageMessage)', '$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets'))" />
  </Target>
  <Target Name="CompileDlssHelperShaders" BeforeTargets="ClCompile"
          Inputs="$(MSBuildThisFileDirectory)shader\hlsl\DlssPrepareCS.hlsl"
          Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\DlssPrepareCS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\DlssCopyCS.cso"
          Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Prepare -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\DlssPrepareCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\DlssPrepareCS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Copy -D DLSS_COPY=1 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\DlssCopyCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\DlssPrepareCS.hlsl&quot;" />
  </Target>
  <Target Name="CopyDlssRuntime" AfterTargets="Build" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <Copy SourceFiles="$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlss.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(DlssSdkRoot)LICENSE.txt" DestinationFiles="$(OutDir)NVIDIA_DLSS_LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNrdLicense" AfterTargets="Build" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <Copy SourceFiles="$(NrdSdkRoot)LICENSE.txt" DestinationFiles="$(OutDir)NVIDIA_NRD_LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CompileRaytracingShader" BeforeTargets="ClCompile"
          Inputs="$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl;$(MSBuildThisFileDirectory)Directory.Build.props"
          Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingCS.cso"
          Condition="'$(Platform)' == 'x64'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -D USE_NRD=0 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </Target>
  <Target Name="CompileNrdRaytracingShaders" BeforeTargets="ClCompile"
          Inputs="$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl;$(NrdSdkRoot)Shaders\NRD.hlsli;$(NrdSdkRoot)Shaders\NRDConfig.hlsli"
          Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingNrdCS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeShadowCS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeAmbientCS.cso"
          Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingNrdCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E ComposeShadow -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeShadowCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E ComposeAmbient -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeAmbientCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </Target>
  <Target Name="CompilePhase5Shaders" BeforeTargets="ClCompile" Condition="'$(Platform)' == 'x64'"
          Inputs="$(MSBuildThisFileDirectory)shader\hlsl\MeshletMS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\MeshletCommon.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\MeshletCullingCommon.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\ClusterCullingCS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\MeshletCullingCS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\BuildMeshDispatchCS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\common.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\GpuSceneCommon.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaquePS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaqueVS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaque.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\DeferredPS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\MaterialSurface.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\SceneRayShadow.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\MeshletVelocityVS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\VelocityGeometryPS.hlsl;$(MSBuildThisFileDirectory)Directory.Build.targets"
          Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletMS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\ClusterCullingCS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletCullingCS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\BuildMeshDispatchCS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletResetCS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletOpaquePS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletFallbackVS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletVelocityMS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletVelocityPS.cso;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletVelocityVS.cso">
    <MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ms_6_5 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletMS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\MeshletMS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\ClusterCullingCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\ClusterCullingCS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletCullingCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\MeshletCullingCS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\BuildMeshDispatchCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\BuildMeshDispatchCS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Reset -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletResetCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\BuildMeshDispatchCS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletOpaquePS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaquePS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T vs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletFallbackVS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaqueVS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ms_6_5 -E main -D MESHLET_VELOCITY=1 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletVelocityMS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\MeshletMS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T ps_6_0 -E main -D MESHLET_VELOCITY=1 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletVelocityPS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\VelocityGeometryPS.hlsl&quot;" />
    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T vs_6_0 -E main  -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletVelocityVS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\MeshletVelocityVS.hlsl&quot;" />
  </Target>
</Project>
