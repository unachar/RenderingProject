    <Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Reset -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletResetCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\BuildMeshDispatchCS.hlsl&quot;" />
  </Target>
  <Target Name="CompilePhase5ShadersMeshletOpaquePS"
          Inputs="$(MSBuildThisFileDirectory)shader\hlsl\common.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\DeferredPS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaque.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaquePS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\GpuSceneCommon.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\MaterialTextureHeap.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\MaterialSurface.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\SceneRayShadow.hlsli;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props"
