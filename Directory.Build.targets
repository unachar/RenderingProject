<?xml version='1.0' encoding='utf-8'?>
<ns0:Project xmlns:ns0="http://schemas.microsoft.com/developer/msbuild/2003">
  <ns0:PropertyGroup>
    <ns0:RayTelemetryShaderInputs>$(MSBuildThisFileDirectory)shader\hlsl\RayTelemetry.hlsli;$(MSBuildThisFileDirectory)source\rendering\raytelemetrylayout.h;$(MSBuildThisFileDirectory)source\rendering\stablesampling.h</ns0:RayTelemetryShaderInputs>
  </ns0:PropertyGroup>




  <ns0:Import Project="$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets" Condition="'$(Platform)' == 'x64' and Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets')" />






  <ns0:PropertyGroup Condition="'$(Platform)' == 'x64' and '$(WindowsSDK_ExecutablePath_x64)' != ''">
    <ns0:FXCToolPath>$(WindowsSDK_ExecutablePath_x64.Split(';')[0])</ns0:FXCToolPath>
  </ns0:PropertyGroup>

  <ns0:Target Name="EnsureDirectXShaderCompilerNuGetPackage" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x64'">
    <ns0:PropertyGroup>
      <ns0:DxcMissingPackageMessage>DXC NuGet package is missing. Restore NuGet packages before building. Missing file: {0}</ns0:DxcMissingPackageMessage>
    </ns0:PropertyGroup>
    <ns0:Error Condition="!Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props')" Text="$([System.String]::Format('$(DxcMissingPackageMessage)', '$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props'))" />
    <ns0:Error Condition="!Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets')" Text="$([System.String]::Format('$(DxcMissingPackageMessage)', '$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.targets'))" />
  </ns0:Target>
  <ns0:Target Name="CompileHiZSpdShader" BeforeTargets="ClCompile" DependsOnTargets="CompileHiZSpdShaderHiZSpdCS" Condition="'$(Platform)' == 'x64'" />

  <ns0:Target Name="CompileHiZSpdShaderHiZSpdCS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\HiZSpdCS.hlsl;$(MSBuildThisFileDirectory)External\FidelityFX-SPD\ffx_spd.h;$(MSBuildThisFileDirectory)External\FidelityFX-SPD\ffx_core.h;$(MSBuildThisFileDirectory)External\FidelityFX-SPD\ffx_core_hlsl.h;$(MSBuildThisFileDirectory)External\FidelityFX-SPD\ffx_core_gpu_common.h;$(MSBuildThisFileDirectory)External\FidelityFX-SPD\ffx_core_gpu_common_half.h;$(MSBuildThisFileDirectory)External\FidelityFX-SPD\ffx_core_portability.h;$(MSBuildThisFileDirectory)External\FidelityFX-SPD\ffx_common_types.h;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\HiZSpdCS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\HiZSpdCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\HiZSpdCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileDecalShadersDecalRasterVS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\DecalRasterVS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\DecalRasterVS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T vs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\DecalRasterVS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\DecalRasterVS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileDecalShadersDecalRasterPS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\DecalRasterPS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\MaterialTextureHeap.hlsli;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\DecalRasterPS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\DecalRasterPS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\DecalRasterPS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileDecalShadersDecalCompositePS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\DecalCompositePS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\DecalCompositePS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T ps_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\DecalCompositePS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\DecalCompositePS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileEnvironmentPrefilterShader" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\EnvironmentPrefilterCS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\EnvironmentPrefilterCS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T cs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\EnvironmentPrefilterCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\EnvironmentPrefilterCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileScreenSpaceReflectionsTraceShader" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\ScreenSpaceReflectionsTraceCS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\ScreenSpaceReflectionsTraceCS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T cs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\ScreenSpaceReflectionsTraceCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\ScreenSpaceReflectionsTraceCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileReferencePathTraceShader" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\ReferencePathTraceCS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\ReferencePathTraceCS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T cs_6_5 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\ReferencePathTraceCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\ReferencePathTraceCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileReferencePathTraceAovShader" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\ReferencePathTraceAovCS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\ReferencePathTraceCS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\ReferencePathTraceAovCS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T cs_6_5 -E AovMain -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\ReferencePathTraceAovCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\ReferencePathTraceAovCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileScreenSpaceReflectionsResolveShader" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\ScreenSpaceReflectionsResolveCS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\ScreenSpaceReflectionsResolveCS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\\native\\bin\\x64\\dxc.exe&quot; -T cs_6_0 -E main -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\ScreenSpaceReflectionsResolveCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\ScreenSpaceReflectionsResolveCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileDlssHelperShaders" BeforeTargets="ClCompile" DependsOnTargets="CompileDlssHelperShadersDlssPrepareCS;CompileDlssHelperShadersDlssCopyCS" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'" />

  <ns0:Target Name="CompileDlssHelperShadersDlssPrepareCS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\DlssPrepareCS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\DlssPrepareCS.cso" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Prepare -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\DlssPrepareCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\DlssPrepareCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileDlssHelperShadersDlssCopyCS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\DlssPrepareCS.hlsl;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\DlssCopyCS.cso" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_0 -E Copy -D DLSS_COPY=1 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\DlssCopyCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\DlssPrepareCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CopyDlssRuntime" AfterTargets="Build" Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <ns0:Copy SourceFiles="$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlss.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <ns0:Copy SourceFiles="$(DlssSdkRoot)LICENSE.txt" DestinationFiles="$(OutDir)NVIDIA_DLSS_LICENSE.txt" SkipUnchangedFiles="true" />
  </ns0:Target>
  <ns0:Target Name="CopyNrdLicense" AfterTargets="Build" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <ns0:Copy SourceFiles="$(NrdSdkRoot)LICENSE.txt" DestinationFiles="$(OutDir)NVIDIA_NRD_LICENSE.txt" SkipUnchangedFiles="true" />
  </ns0:Target>
  <ns0:Target Name="CompileRaytracingShader" BeforeTargets="ClCompile" DependsOnTargets="CompileRaytracingShaderRaytracingCS" Condition="'$(Platform)' == 'x64'" />

  <ns0:Target Name="CompileRaytracingShaderRaytracingCS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingCS.cso" Condition="'$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -D USE_NRD=0 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileNrdRaytracingShaders" BeforeTargets="ClCompile" DependsOnTargets="CompileNrdRaytracingShadersRaytracingNrdCS;CompileNrdRaytracingShadersNrdComposeShadowCS;CompileNrdRaytracingShadersNrdComposeAmbientCS" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'" />

  <ns0:Target Name="CompileNrdRaytracingShadersRaytracingNrdCS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)External\NRD\sdk\Shaders\NRD.hlsli;$(MSBuildThisFileDirectory)External\NRD\sdk\Shaders\NRDConfig.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingNrdCS.cso" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E main -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\RaytracingNrdCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileNrdRaytracingShadersNrdComposeShadowCS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)External\NRD\sdk\Shaders\NRD.hlsli;$(MSBuildThisFileDirectory)External\NRD\sdk\Shaders\NRDConfig.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeShadowCS.cso" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E ComposeShadow -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeShadowCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompileNrdRaytracingShadersNrdComposeAmbientCS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)External\NRD\sdk\Shaders\NRD.hlsli;$(MSBuildThisFileDirectory)External\NRD\sdk\Shaders\NRDConfig.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl;$(RayTelemetryShaderInputs);$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeAmbientCS.cso" Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <ns0:MakeDir Directories="$(MSBuildThisFileDirectory)shader\hlsl\build" />
    <ns0:Exec Command="&quot;$(DirectXShaderCompilerPackageRoot)build\native\bin\x64\dxc.exe&quot; -T cs_6_5 -E ComposeAmbient -D USE_NRD=1 -HV 2021 -O3 -Fo &quot;$(MSBuildThisFileDirectory)shader\hlsl\build\NrdComposeAmbientCS.cso&quot; &quot;$(MSBuildThisFileDirectory)shader\hlsl\RaytracingCS.hlsl&quot;" />
  </ns0:Target>
  <ns0:Target Name="CompilePhase5Shaders" BeforeTargets="ClCompile" DependsOnTargets="CompilePhase5ShadersMeshletMS;CompilePhase5ShadersClusterCullingCS;CompilePhase5ShadersMeshletCullingCS;CompilePhase5ShadersBuildMeshDispatchCS;CompilePhase5ShadersMeshletResetCS;CompilePhase5ShadersMeshletOpaquePS;CompilePhase5ShadersMeshletFallbackVS;CompilePhase5ShadersMeshletVelocityMS;CompilePhase5ShadersMeshletVelocityPS;CompilePhase5ShadersMeshletVelocityVS" Condition="'$(Platform)' == 'x64'" />

  <ns0:Target Name="CompilePhase5ShadersMeshletMS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\ProceduralTexture.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\common.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\CameraProjection.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\GpuSceneCommon.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\MeshletCommon.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\MeshletMS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\SceneRayShadow.hlsli;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletMS.cso" Condition="'$(Platform)' == 'x64'">
