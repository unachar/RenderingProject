  <ns0:Target Name="CompilePhase5ShadersMeshletOpaquePS" Inputs="$(MSBuildThisFileDirectory)shader\hlsl\ProceduralTexture.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\noise.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\common.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\CameraProjection.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\GeometricSpecularAA.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\DeferredPS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaque.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\GPUDrivenOpaquePS.hlsl;$(MSBuildThisFileDirectory)shader\hlsl\GpuSceneCommon.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\MaterialSurface.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\ToonLighting.hlsli;$(MSBuildThisFileDirectory)shader\hlsl\SceneRayShadow.hlsli;$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)Directory.Build.props" Outputs="$(MSBuildThisFileDirectory)shader\hlsl\build\MeshletOpaquePS.cso" Condition="'$(Platform)' == 'x64'">
