<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DirectXShaderCompilerPackageVersion>1.9.2602.24</DirectXShaderCompilerPackageVersion>
    <DirectXShaderCompilerPackageRoot>$(MSBuildThisFileDirectory)packages\Microsoft.Direct3D.DXC.$(DirectXShaderCompilerPackageVersion)\</DirectXShaderCompilerPackageRoot>
  </PropertyGroup>



  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(MSBuildThisFileDirectory)source\assets;
        $(MSBuildThisFileDirectory)source\core;
        $(MSBuildThisFileDirectory)source\ecs;
        $(MSBuildThisFileDirectory)source\editor;
        $(MSBuildThisFileDirectory)source\entities;
        $(MSBuildThisFileDirectory)source\models;
        $(MSBuildThisFileDirectory)source\physics;
        $(MSBuildThisFileDirectory)source\rendering;
        $(MSBuildThisFileDirectory)source\scene;
        $(MSBuildThisFileDirectory)source\systems;
        $(MSBuildThisFileDirectory)External\ImGUI;
        $(MSBuildThisFileDirectory)External\DLSS\include;
        $(MSBuildThisFileDirectory)External\NVAPI\include;
        $(MSBuildThisFileDirectory)External\NRD\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(MSBuildThisFileDirectory)External\DLSS\lib\x64;
        $(MSBuildThisFileDirectory)External\NVAPI\lib\x64;
        $(MSBuildThisFileDirectory)External\NRD\lib\x64;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        nvsdk_ngx.lib;
        nvapi64.lib;
        nrd.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>






  <Import Project="$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props"
          Condition="'$(Platform)' == 'x64' and Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props')" />

  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">
    <ClCompile>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_DXC=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>

      <AdditionalDependencies>dxcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
