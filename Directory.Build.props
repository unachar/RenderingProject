<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DirectXShaderCompilerPackageVersion>1.9.2602.24</DirectXShaderCompilerPackageVersion>
    <DirectXShaderCompilerPackageRoot>$(MSBuildThisFileDirectory)packages\Microsoft.Direct3D.DXC.$(DirectXShaderCompilerPackageVersion)\</DirectXShaderCompilerPackageRoot>
    <DlssSdkRoot>$(MSBuildThisFileDirectory)External\DLSS\sdk\</DlssSdkRoot>
    <EnableDlss Condition="'$(EnableDlss)' == '' and '$(Platform)' == 'x64' and Exists('$(DlssSdkRoot)include\nvsdk_ngx.h') and Exists('$(DlssSdkRoot)lib\Windows_x86_64\x64\nvsdk_ngx_s.lib') and Exists('$(DlssSdkRoot)lib\Windows_x86_64\x64\nvsdk_ngx_s_dbg.lib') and Exists('$(DlssSdkRoot)lib\Windows_x86_64\rel\nvngx_dlss.dll')">true</EnableDlss>
    <EnableDlss Condition="'$(EnableDlss)' == ''">false</EnableDlss>
    <DlssLibrary Condition="'$(Configuration)' == 'Debug'">nvsdk_ngx_s_dbg.lib</DlssLibrary>
    <DlssLibrary Condition="'$(Configuration)' != 'Debug'">nvsdk_ngx_s.lib</DlssLibrary>
    <NrdSdkRoot>$(MSBuildThisFileDirectory)External\NRD\sdk\</NrdSdkRoot>
    <EnableNrd Condition="'$(EnableNrd)' == '' and '$(Platform)' == 'x64' and Exists('$(NrdSdkRoot)Include\NRD.h') and Exists('$(NrdSdkRoot)_Bin\$(Configuration)\NRD.lib') and Exists('$(NrdSdkRoot)_Build\_deps\shadermake-build\$(Configuration)\ShaderMakeBlob.lib')">true</EnableNrd>
    <EnableNrd Condition="'$(EnableNrd)' == ''">false</EnableNrd>
    <OptixSdkRoot>$(MSBuildThisFileDirectory)External\OptiX\sdk\</OptixSdkRoot>
    <CudaHeaderRoot>$(MSBuildThisFileDirectory)External\CUDA\sdk\include\</CudaHeaderRoot>
    <EnableOptix Condition="'$(EnableOptix)' == '' and '$(Platform)' == 'x64' and Exists('$(OptixSdkRoot)include\optix.h') and Exists('$(CudaHeaderRoot)cuda.h')">true</EnableOptix>
    <EnableOptix Condition="'$(EnableOptix)' == ''">false</EnableOptix>
    <OcioRoot>$(MSBuildThisFileDirectory)External\OpenColorIO\</OcioRoot>
    <EnableOcio Condition="'$(EnableOcio)' == '' and '$(Platform)' == 'x64' and Exists('$(OcioRoot)include\OpenColorIO\OpenColorIO.h') and Exists('$(OcioRoot)lib\OpenColorIO.lib')">true</EnableOcio>
    <EnableOcio Condition="'$(EnableOcio)' == ''">false</EnableOcio>
    <AclRoot>$(MSBuildThisFileDirectory)External\ACL\</AclRoot>
    <EnableAcl Condition="'$(EnableAcl)' == '' and '$(Platform)' == 'x64' and Exists('$(AclRoot)acl\compression\compress.h') and Exists('$(AclRoot)lib\acl.lib')">true</EnableAcl>
    <EnableAcl Condition="'$(EnableAcl)' == ''">false</EnableAcl>
    <KtxRoot>$(MSBuildThisFileDirectory)External\KTX-Software\</KtxRoot>
    <BasisRoot>$(MSBuildThisFileDirectory)External\basis_universal\</BasisRoot>
    <EnableBasis Condition="'$(EnableBasis)' == '' and '$(Platform)' == 'x64' and Exists('$(BasisRoot)transcoder\basisu_transcoder.h') and Exists('$(BasisRoot)lib\basisu.lib')">true</EnableBasis>
    <EnableBasis Condition="'$(EnableBasis)' == ''">false</EnableBasis>
    <EnableKtx Condition="'$(EnableKtx)' == '' and '$(Platform)' == 'x64' and Exists('$(KtxRoot)include\ktx.h') and Exists('$(KtxRoot)lib\ktx.lib')">true</EnableKtx>
    <EnableKtx Condition="'$(EnableKtx)' == ''">false</EnableKtx>
    <ShaderMakeRoot>$(MSBuildThisFileDirectory)External\ShaderMake\</ShaderMakeRoot>
    <EnableShaderMake>false</EnableShaderMake>
  </PropertyGroup>



  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(MSBuildThisFileDirectory)source\assets;
        $(MSBuildThisFileDirectory)External\RTXNS\external\donut\thirdparty\jsoncpp\include;
        $(MSBuildThisFileDirectory)source\core;
        $(MSBuildThisFileDirectory)source\ecs;
        $(MSBuildThisFileDirectory)source\editor;
        $(MSBuildThisFileDirectory)source\entities;
        $(MSBuildThisFileDirectory)source\models;
        $(MSBuildThisFileDirectory)source\physics;
        $(MSBuildThisFileDirectory)source\procedural;
        $(MSBuildThisFileDirectory)source\rendering;
        $(MSBuildThisFileDirectory)source\scene;
        $(MSBuildThisFileDirectory)source\systems;
        $(MSBuildThisFileDirectory)External\ImGUI;
        $(MSBuildThisFileDirectory)External\NVAPI\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(MSBuildThisFileDirectory)External\NVAPI\lib\x64;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableDlss)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(DlssSdkRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_DLSS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DlssSdkRoot)lib\Windows_x86_64\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(DlssLibrary);advapi32.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableOptix)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(OptixSdkRoot)include;$(CudaHeaderRoot);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_OPTIX=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableNrd)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(NrdSdkRoot)Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_NRD=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(NrdSdkRoot)_Bin\$(Configuration);$(NrdSdkRoot)_Build\_deps\shadermake-build\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>NRD.lib;ShaderMakeBlob.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableOcio)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(OcioRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_OCIO=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(OcioRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>OpenColorIO.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableAcl)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(AclRoot)acl;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_ACL=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(AclRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>acl.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableKtx)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(KtxRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_KTX=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(KtxRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ktx.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableBasis)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(BasisRoot)transcoder;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_BASIS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(BasisRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>basisu.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(EnableShaderMake)' == 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ShaderMakeRoot)ShaderMake;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RENDERINGPROJECT_USE_SHADERMAKE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ShaderMakeRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ShaderMake.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>






  <Import Project="$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props"
          Condition="'$(Platform)' == 'x64' and Exists('$(DirectXShaderCompilerPackageRoot)build\native\Microsoft.Direct3D.DXC.props')" />

  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">
    <ClCompile>
      <PreprocessorDefinitions>RENDERINGPROJECT_BUILD_SHARED_PCH=1;RENDERINGPROJECT_USE_DXC=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>

      <AdditionalDependencies>dxcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
